# Replace YOUR_COMPUTER_LAN_IP with the IPv4 address from ipconfig.
# Phone and computer must be on the same Wi-Fi network.
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:5000
# Leave empty for Expo Go. For a native production build, set this to the same
# URL as VNPAY_CLIENT_RETURN_URL in server/.env (for example client://booking/payment).
