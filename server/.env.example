PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/flight_booking

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

REDIS_URL=redis://127.0.0.1:6379

CLIENT_URL=http://localhost:8081

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# VNPay Sandbox (lấy thông tin sandbox từ VNPay)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Phải là URL HTTPS public của API server; cấu hình IPN tương ứng trong merchant portal VNPay.
VNPAY_RETURN_URL=https://YOUR_PUBLIC_API/api/payments/vnpay/return
VNPAY_IPN_URL=https://YOUR_PUBLIC_API/api/payments/vnpay/ipn
# Dùng cho bản build native/production; Expo Go development gửi deep link runtime đã kiểm tra allowlist.
VNPAY_CLIENT_RETURN_URL=client://booking/payment
VNPAY_ORDER_TYPE=other
VNPAY_LOCALE=vn